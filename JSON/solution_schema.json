{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "https://github.com/aicenter/Ridesharing_DARP_instances/blob/main/solution_schema.json",
    "type": "object",
    "title": "DARP ridesharing solution",
    "required": [
        "cost",
        "cost_minutes",
        "plans",
        "dropped_requests"
    ],
    "$defs": {
        "unservedStopLeg": {
            "type": "object",
            "required": [
                "id",
                "request_index",
                "type",
                "position",
                "min_time",
                "max_time",
                "service_duration"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "title": "Unique stop or operation id"
                },
                "request_index": {
                    "type": "integer",
                    "title": "Index of the passenger request"
                },
                "type": {
                    "type": "string",
                    "title": "Leg kind: pickup or drop_off"
                },
                "position": {
                    "type": "object",
                    "title": "Stop location as a road graph node",
                    "required": [
                        "index"
                    ],
                    "properties": {
                        "index": {
                            "type": "integer",
                            "title": "Road graph node index"
                        }
                    }
                },
                "min_time": {
                    "type": "integer",
                    "title": "Earliest service time at this stop (seconds from horizon origin)"
                },
                "max_time": {
                    "type": "integer",
                    "title": "Latest service time at this stop (seconds from horizon origin)"
                },
                "service_duration": {
                    "type": "integer",
                    "title": "Time spent loading or unloading (seconds)"
                }
            }
        }
    },
    "properties": {
        "cost": {
            "type": "integer",
            "default": 0,
            "title": "Total objective cost over all vehicles (seconds)"
        },
        "cost_minutes": {
            "type": "integer",
            "default": 0,
            "title": "Same total cost expressed in whole minutes (rounded)"
        },
        "plans": {
            "type": "array",
            "default": [],
            "title": "One route plan per vehicle that is used in the solution",
            "items": {
                "$ref": "vehicle_plan_schema.json"
            }
        },
        "dropped_requests": {
            "type": "array",
            "default": [],
            "title": "Requests that were not assigned to any vehicle",
            "items": {
                "type": "object",
                "title": "Dropped request with its pickup and drop-off definition",
                "required": [
                    "index",
                    "pickup",
                    "drop_off",
                    "min_travel_time"
                ],
                "properties": {
                    "index": {
                        "type": "integer",
                        "title": "Request index in the problem instance"
                    },
                    "pickup": {
                        "title": "Pickup leg for this dropped request",
                        "allOf": [
                            {
                                "$ref": "#/$defs/unservedStopLeg"
                            }
                        ]
                    },
                    "drop_off": {
                        "title": "Drop-off leg for this dropped request",
                        "allOf": [
                            {
                                "$ref": "#/$defs/unservedStopLeg"
                            }
                        ]
                    },
                    "min_travel_time": {
                        "type": "integer",
                        "title": "Minimum feasible driving time from pickup node to drop-off node (seconds)"
                    }
                }
            }
        }
    }
}
