{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "https://github.com/aicenter/Ridesharing_DARP_instances/blob/main/JSON/vehicle_plan.schema.json",
    "type": "object",
    "title": "Single-vehicle route plan",
    "required": [
        "cost",
        "vehicle",
        "departure_time",
        "arrival_time",
        "actions"
    ],
    "properties": {
        "cost": {
            "type": "integer",
            "title": "Cost of this vehicle's route (seconds)"
        },
        "vehicle": {
            "type": "object",
            "title": "Vehicle this plan is assigned to (fleet or virtual slot)",
            "properties": {
                "capacity": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Omitted in JSON → implementation default (e.g. 4)."
                }
            },
            "if": {
                "properties": {
                    "type": { "const": "virtual" }
                }
            },
            "then": {
                "properties": {
                    "time_to_start": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Seconds; omitted → 0."
                    },
                    "vehicle_count": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Omitted → 1."
                    }
                }
            },
            "else": {
                "required": ["index"],
                "properties": {
                    "index": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Index into the instance fleet (DARP_instance vehicles)."
                    },
                    "init_position": {
                        "type": "object",
                        "description": "Optional; not read by JSON_deserialize but useful for interchange.",
                        "required": ["index"],
                        "properties": {
                            "index": { "type": "integer", "minimum": 0 }
                        }
                    }
                }
            }
        },
        "departure_time": {
            "type": "integer",
            "title": "Time the vehicle departs its start (seconds from horizon origin)"
        },
        "arrival_time": {
            "type": "integer",
            "title": "Time the vehicle completes the route (seconds from horizon origin)"
        },
        "actions": {
            "type": "array",
            "title": "Ordered list of stops (pickups and drop-offs)",
            "items": {
                "type": "object",
                "title": "One timetable row at a stop",
                "required": [
                    "arrival_time",
                    "departure_time",
                    "action"
                ],
                "properties": {
                    "arrival_time": {
                        "type": "integer",
                        "title": "Arrival time at this stop (seconds from horizon origin)"
                    },
                    "departure_time": {
                        "type": "integer",
                        "title": "Departure time from this stop (seconds from horizon origin)"
                    },
                    "action": {
                        "type": "object",
                        "title": "Request operation performed at this stop",
                        "required": [
                            "request_index",
                            "type"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer",
                                "title": "Unique stop or operation id"
                            },
                            "request_index": {
                                "type": "integer",
                                "title": "Index of the passenger request"
                            },
                            "type": {
                                "type": "string",
                                "title": "Operation kind: pickup or drop_off"
                            },
                            "position": {
                                "type": "object",
                                "title": "Stop coordinates as a graph node",
                                "required": [
                                    "index"
                                ],
                                "properties": {
                                    "index": {
                                        "type": "integer",
                                        "title": "Road graph node index for this stop"
                                    }
                                }
                            },
                            "min_time": {
                                "type": "integer",
                                "title": "Earliest time window bound for serving this stop (seconds)"
                            },
                            "max_time": {
                                "type": "integer",
                                "title": "Latest time window bound for serving this stop (seconds)"
                            },
                            "service_duration": {
                                "type": "integer",
                                "title": "Time spent loading or unloading at the stop (seconds)"
                            }
                        }
                    }
                }
            }
        }
    }
}
