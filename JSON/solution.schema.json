{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "https://github.com/aicenter/Ridesharing_DARP_instances/blob/main/JSON/solution.schema.json",
    "type": "object",
    "title": "DARP ridesharing solution",
    "required": [
        "cost",
        "plans",
        "dropped_requests"
    ],
    "properties": {
        "cost": {
            "type": "integer",
            "default": 0,
            "title": "Total objective cost over all vehicles (seconds)"
        },
        "cost_minutes": {
            "type": "integer",
            "default": 0,
            "title": "Same total cost expressed in whole minutes (rounded)"
        },
        "virtual_vehicle": {
            "title": "Virtual vehicle used in the solution",
            "$ref": "virtual_vehicle.schema.json"
        },
        "plans": {
            "type": "array",
            "default": [],
            "title": "One route plan per vehicle that is used in the solution",
            "items": {
                "$ref": "vehicle_plan.schema.json"
            }
        },
        "dropped_requests": {
            "type": "array",
            "default": [],
            "title": "Requests that were not assigned to any vehicle",
            "items": {
                "type": "object",
                "title": "Dropped request with its pickup and drop-off definition",
                "required": [
                    "index",
                    "pickup",
                    "drop_off",
                    "min_travel_time"
                ],
                "properties": {
                    "index": {
                        "type": "integer",
                        "title": "Request index in the problem instance"
                    },
                    "pickup": {
                        "title": "Pickup leg for this dropped request",
                        "allOf": [
                            {
                                "$ref": "action.schema.json"
                            }
                        ]
                    },
                    "drop_off": {
                        "title": "Drop-off leg for this dropped request",
                        "allOf": [
                            {
                                "$ref": "action.schema.json"
                            }
                        ]
                    },
                    "min_travel_time": {
                        "type": "integer",
                        "title": "Minimum feasible driving time from pickup node to drop-off node (seconds)"
                    }
                }
            }
        }
    },
    "if": {
        "properties": {
            "plans": {
                "contains": {
                    "type": "object",
                    "properties": {
                        "vehicle": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "virtual"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "then": {
        "required": [
            "virtual_vehicle"
        ]
    }
}
