{
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "$id": "https://github.com/aicenter/Ridesharing_DARP_instances/blob/main/JSON/solution.schema.json",
    "type": "object",
    "title": "DARP ridesharing solution",
    "required": [
        "cost",
        "plans",
        "dropped_requests"
    ],
    "properties": {
        "problem": {
            "enum": [
                "DARP",
                "fleet-sizing"
            ]
        },
        "cost": {
            "type": "number",
            "default": 0,
            "title": "Total generalized cost over all plans (sum of the plan costs); equals the total travel time in seconds under the default cost weights"
        },
        "cost_minutes": {
            "type": "integer",
            "default": 0,
            "title": "cost / 60 rounded to whole minutes (legacy convenience field)"
        },
        "cost_components": {
            "title": "Optional per-component breakdown of cost (weighted contributions summing to cost)",
            "$ref": "cost_components.schema.json"
        },
        "vehicles": {
            "type": "array",
            "default": [],
            "title": "Vehicles used in the solution. Required for fleet-sizing problems.",
            "items": {
                "$ref": "vehicle.schema.json"
            }
        },
        "virtual_vehicle": {
            "title": "Virtual vehicle used in the solution",
            "$ref": "virtual_vehicle.schema.json"
        },
        "plans": {
            "type": "array",
            "default": [],
            "title": "One route plan per vehicle that is used in the solution",
            "items": {
                "$ref": "vehicle_plan.schema.json"
            }
        },
        "dropped_requests": {
            "type": "array",
            "default": [],
            "title": "Requests that were not assigned to any vehicle",
            "items": {
                "type": "object",
                "title": "Dropped request with its pickup and drop-off definition",
                "required": [
                    "index",
                    "pickup",
                    "drop_off",
                    "min_travel_time"
                ],
                "properties": {
                    "index": {
                        "type": "integer",
                        "title": "Request index in the problem instance"
                    },
                    "pickup": {
                        "title": "Pickup leg for this dropped request",
                        "allOf": [
                            {
                                "$ref": "action.schema.json"
                            }
                        ]
                    },
                    "drop_off": {
                        "title": "Drop-off leg for this dropped request",
                        "allOf": [
                            {
                                "$ref": "action.schema.json"
                            }
                        ]
                    },
                    "min_travel_time": {
                        "type": "integer",
                        "title": "Minimum feasible driving time from pickup node to drop-off node (seconds)"
                    }
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "problem": {
                        "const": "fleet-sizing"
                    }
                }
            },
            "then": {
                "required": [
                    "vehicles"
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "plans": {
                        "contains": {
                            "type": "object",
                            "properties": {
                                "vehicle": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "const": "virtual"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "then": {
                "required": [
                    "virtual_vehicle"
                ]
            }
        }
    ]
}
